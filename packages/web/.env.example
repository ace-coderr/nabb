# Every variable is optional. With none set, the app talks only to GIWA Sepolia and reads all
# drops and claims directly from the deployed NabbMarket contract.

# RPC overrides.
# VITE_GIWA_RPC_URL=https://sepolia-rpc.giwa.io
# VITE_GIWA_FLASHBLOCKS_RPC_URL=https://sepolia-rpc-flashblocks.giwa.io

# Optional indexer (packages/indexer). Used only while its /health check passes for this chain
# and contract; otherwise the app falls back to on-chain reads without any visible error.
# VITE_INDEXER_URL=https://your-indexer.example.com
