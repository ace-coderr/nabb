# All optional.
# PORT=8787
# HOST=0.0.0.0
# GIWA_SEPOLIA_RPC_URL=https://sepolia-rpc.giwa.io
# Blocks to stay behind the head before indexing (protects against shallow reorgs).
# CONFIRMATIONS=2
# POLL_INTERVAL_MS=1000
# Where the state snapshot is written.
# DATA_DIR=./data
# Comma-separated allowed origins for CORS; * allows any.
# CORS_ORIGIN=*
