{
  "name": "nabb",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time, non-custodial claim market on GIWA",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @nabb/web --filter @nabb/indexer dev",
    "dev:web": "pnpm --filter @nabb/web dev",
    "dev:indexer": "pnpm --filter @nabb/indexer dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contracts:deploy": "pnpm --filter @nabb/contracts deploy:giwa-sepolia",
    "contracts:verify": "pnpm --filter @nabb/contracts verify:giwa-sepolia",
    "contracts:demo-drop": "pnpm --filter @nabb/contracts demo-drop:giwa-sepolia",
    "config:sync": "pnpm --filter @nabb/contracts build && pnpm --filter @nabb/config sync"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-solidity": "^2.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
